<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
    
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    
    <domain-config>
        <domain includeSubdomains="true">api.modrinth.com</domain>
        <domain includeSubdomains="true">api.curseforge.com</domain>
        <domain includeSubdomains="true">launchermeta.mojang.com</domain>
        <domain includeSubdomains="true">meta.fabricmc.net</domain>
        <domain includeSubdomains="true">meta.quiltmc.org</domain>
        <domain includeSubdomains="true">maven.minecraftforge.net</domain>
        <domain includeSubdomains="true">libraries.minecraft.net</domain>
        <domain includeSubdomains="true">bmclapi2.bangbang93.com</domain>
        <domain includeSubdomains="true">download.modrinth.com</domain>
        <domain includeSubdomains="true">media.forgecdn.net</domain>
    </domain-config>
    
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>